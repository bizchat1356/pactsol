---
import { links } from '../lib/business-links';
const items = [{label:'Home', href:links.home}, {label:'B2B Sourcing', href:links.sourcing}, {label:'Software Consultancy', href:links.software}];
---
<header id="top" class="site-header"><div class="site-container site-header__inner">
<a class="site-header__brand" href={links.home} aria-label="PACTSOL home"><span class="site-header__brand-name">PACTSOL</span><span class="site-header__brand-tagline">Sourcing &amp; Software Consultancy</span></a>
<div class="site-header__desktop"><nav class="site-header__nav" aria-label="Primary navigation">{items.map(item => <a href={item.href}>{item.label}</a>)}</nav><a class="site-header__cta" href="#contact">Contact</a></div>
<details class="site-header__mobile-menu"><summary aria-label="Open navigation">☰</summary><nav class="site-header__mobile-nav" aria-label="Mobile navigation">{items.map(item => <a href={item.href}>{item.label}</a>)}<a href="#contact">Contact</a></nav></details>
</div></header><script is:inline src="/scripts/mobile-nav.js"></script>
