---
const sourcingCategories = [
  {
    number: '01',
    title: 'Packaging & Dispatch Consumables',
    description:
      'Selected products supporting routine packaging, protection, and dispatch requirements.',
    products: [
      'Stretch film',
      'BOPP and packaging tapes',
      'Strapping materials',
      'Bubble and protective packaging',
    ],
  },
  {
    number: '02',
    title: 'Maintenance & Fabrication Consumables',
    description:
      'Selected consumables used across maintenance, fabrication, and workshop requirements.',
    products: [
      'Welding electrodes',
      'Cutting discs',
      'Grinding and abrasive consumables',
      'Selected maintenance consumables',
    ],
  },
  {
    number: '03',
    title: 'Safety & PPE',
    description:
      'Selected workplace safety and personal protective equipment requirements.',
    products: [
      'Safety footwear',
      'Protective gloves',
      'Safety helmets',
      'Selected protective equipment',
    ],
  },
  {
    number: '04',
    title: 'Material Handling & Warehouse MRO',
    description:
      'Selected replacement and maintenance products supporting warehouse and material-handling operations.',
    products: [
      'Conveyor rollers and idlers',
      'Pallet-truck load wheels and steering wheels',
      'Industrial castors and heavy-duty wheels',
      'Conveyor chains and sprockets',
      'Selected conveyor replacement components',
    ],
  },
  {
    number: '05',
    title: 'General Industrial Replacement MRO',
    description:
      'Selected industrial replacement components supporting routine maintenance and equipment upkeep.',
    products: [
      'Ordinary mechanical seals',
      'Industrial hose assemblies',
      'Selected pump replacement parts',
      'Non-specialised gasket and sealing components',
    ],
  },
  {
    number: '06',
    title: 'Micro-Irrigation / Agricultural Infrastructure',
    description:
      'Selected components supporting micro-irrigation systems and agricultural infrastructure requirements.',
    products: [
      'Irrigation filters and replacement elements',
      'Venturi injectors',
      'Irrigation valves',
      'Pressure regulators',
      'Repair connectors and fittings',
    ],
  },
  {
    number: '07',
    title: 'Low-risk Solar O&M Accessories',
    description:
      'Selected non-electrical accessories supporting routine solar operation and maintenance requirements.',
    products: [
      'Module-cleaning replacement components',
      'Selected mounting clamps and fasteners',
      'Non-electrical cable-management hardware',
      'Selected mechanical O&M accessories',
    ],
  },
];
---

<section
  id="sourcing-categories"
  class="sourcing-categories"
>
  <div class="site-container">

    <div class="sourcing-categories__intro">

      <p class="sourcing-categories__label">
        Current Sourcing Categories
      </p>

      <h2>
        Focused on selected industrial sourcing categories.
      </h2>

      <p>
        PACTSOL currently accepts sourcing enquiries across selected products
        within the categories below. Product availability, specifications,
        quantities, pricing, delivery, and other commercial terms remain
        subject to sourcing and supplier confirmation.
      </p>

    </div>

    <div class="sourcing-categories__grid">

      {
        sourcingCategories.map((category) => (
          <article class="sourcing-card">

            <div class="sourcing-card__inner">

              <div
                class="sourcing-card__face sourcing-card__front"
                aria-hidden="false"
              >

                <div class="sourcing-card__content">

                  <p class="sourcing-card__number">
                    {category.number}
                  </p>

                  <h3>
                    {category.title}
                  </h3>

                  <p class="sourcing-card__description">
                    {category.description}
                  </p>

                </div>

                <button
                  type="button"
                  class="sourcing-card__toggle sourcing-card__toggle--front"
                  aria-expanded="false"
                  aria-controls={`sourcing-card-details-${category.number}`}
                  aria-label={`View product families for ${category.title}`}
                >
                  <span>View product families</span>
                  <span aria-hidden="true">→</span>
                </button>

              </div>

              <div
                id={`sourcing-card-details-${category.number}`}
                class="sourcing-card__face sourcing-card__back"
                aria-hidden="true"
                inert
              >

                <div class="sourcing-card__content">

                  <p class="sourcing-card__number">
                    {category.number}
                  </p>

                  <p class="sourcing-card__back-label">
                    Selected Product Families
                  </p>

                  <h3>
                    {category.title}
                  </h3>

                  <ul>
                    {
                      category.products.map((product) => (
                        <li>{product}</li>
                      ))
                    }
                  </ul>

                </div>

                <div class="sourcing-card__actions">

                  <button
                    type="button"
                    class="sourcing-card__toggle sourcing-card__toggle--back"
                    aria-label={`Return to ${category.title}`}
                  >
                    <span aria-hidden="true">←</span>
                    <span>Back</span>
                  </button>

                </div>

              </div>

            </div>

          </article>
        ))
      }

    </div>

    <!--
    <div class="sourcing-categories__footer">

      <p>
        Have an industrial sourcing requirement outside these categories?
        PACTSOL may review the requirement to determine whether suitable
        sourcing support can be provided.
      </p>

      <a
        href="/request-quote"
        target="_blank"
        rel="noopener noreferrer"
      >
        Request a Quote →
      </a>

    </div>
    -->

  </div>
</section>

<script>
  function initializeSourcingCards() {
    const cards = document.querySelectorAll<HTMLElement>('.sourcing-card');

    cards.forEach((card) => {
      if (card.dataset.initialized === 'true') {
        return;
      }

      const front = card.querySelector<HTMLElement>('.sourcing-card__front');
      const back = card.querySelector<HTMLElement>('.sourcing-card__back');
      const frontToggle = card.querySelector<HTMLButtonElement>(
        '.sourcing-card__toggle--front'
      );
      const backToggle = card.querySelector<HTMLButtonElement>(
        '.sourcing-card__toggle--back'
      );

      if (!front || !back || !frontToggle || !backToggle) {
        return;
      }

      card.dataset.initialized = 'true';

      const setFlippedState = (isFlipped: boolean, moveFocus = false) => {
        card.classList.toggle('is-flipped', isFlipped);

        front.setAttribute('aria-hidden', isFlipped ? 'true' : 'false');
        back.setAttribute('aria-hidden', isFlipped ? 'false' : 'true');

        front.toggleAttribute('inert', isFlipped);
        back.toggleAttribute('inert', !isFlipped);

        frontToggle.setAttribute(
          'aria-expanded',
          isFlipped ? 'true' : 'false'
        );

        if (moveFocus) {
          (isFlipped ? backToggle : frontToggle).focus();
        }
      };

      setFlippedState(false);

      frontToggle.addEventListener('click', () => {
        setFlippedState(true, true);
      });

      backToggle.addEventListener('click', () => {
        setFlippedState(false, true);
      });
    });
  }

  initializeSourcingCards();

  document.addEventListener('astro:page-load', initializeSourcingCards);
</script>

<style>
  .sourcing-categories {
    padding: 6rem 0;
    background: #f7f4ee;
  }

  .sourcing-categories__intro {
    max-width: 820px;
    margin-bottom: 3rem;
  }

  .sourcing-categories__label {
    margin: 0 0 0.85rem;
    color: #57643a;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .sourcing-categories__intro h2 {
    max-width: 760px;
    margin: 0 0 1.25rem;
    color: #0b3558;
    font-size: clamp(2rem, 4vw, 3.15rem);
    line-height: 1.08;
  }

  .sourcing-categories__intro > p:last-child {
    margin: 0;
    color: #1f2937;
    font-size: 1rem;
    line-height: 1.8;
  }

  .sourcing-categories__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .sourcing-card {
    min-width: 0;
    min-height: 520px;
    perspective: 1200px;
  }

  .sourcing-card__inner {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 520px;
    transform-style: preserve-3d;
    transition:
      transform 0.65s cubic-bezier(0.2, 0.75, 0.25, 1),
      filter 0.25s ease;
  }

  .sourcing-card.is-flipped .sourcing-card__inner {
    transform: rotateY(180deg);
  }

  .sourcing-card__face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.75rem;
    overflow: hidden;
    border: 1px solid #d8dccf;
    border-radius: 14px;
    background: #ffffff;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: box-shadow 0.25s ease;
  }

  .sourcing-card__back {
    transform: rotateY(180deg);
    background: #f2f4f3;
  }

  .sourcing-card__number {
    margin: 0 0 1.1rem;
    color: #57643a;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .sourcing-card h3 {
    margin: 0 0 1rem;
    color: #0b3558;
    font-size: 1.2rem;
    line-height: 1.35;
  }

  .sourcing-card__description {
    margin: 0;
    color: #1f2937;
    font-size: 0.96rem;
    line-height: 1.7;
  }

  .sourcing-card__back-label {
    margin: 0 0 0.55rem;
    color: #57643a;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .sourcing-card ul {
    margin: 0;
    padding-left: 1.15rem;
  }

  .sourcing-card li {
    margin-bottom: 0.65rem;
    color: #1f2937;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .sourcing-card__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    margin-top: 1.5rem;
    padding: 0.9rem 1rem;
    border: 1px solid #52718a;
    border-radius: 8px;
    background: transparent;
    color: #0b3558;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    text-align: left;
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .sourcing-card__toggle:hover,
  .sourcing-card__toggle:focus-visible {
    border-color: #0b3558;
    background: #0b3558;
    color: #ffffff;
  }

  .sourcing-card__toggle:focus-visible {
    outline: 3px solid rgba(82, 113, 138, 0.35);
    outline-offset: 3px;
  }

  .sourcing-card__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .sourcing-card__toggle--back {
    justify-content: flex-start;
    margin-top: 0;
  }

  /*
  .sourcing-categories__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #d8dccf;
  }

  .sourcing-categories__footer p {
    max-width: 720px;
    margin: 0;
    color: #1f2937;
    line-height: 1.7;
  }

  .sourcing-categories__footer > a {
    flex: 0 0 auto;
    color: #0b3558;
    font-weight: 700;
    text-decoration: none;
  }

  .sourcing-categories__footer > a:hover {
    text-decoration: underline;
  }
  */

  @media (hover: hover) and (pointer: fine) {
    .sourcing-card:hover .sourcing-card__face {
      box-shadow: 0 12px 24px rgba(11, 53, 88, 0.1);
    }

    .sourcing-card:not(.is-flipped):hover .sourcing-card__inner {
      transform: translateY(-4px);
    }

    .sourcing-card.is-flipped:hover .sourcing-card__inner {
      transform: translateY(-4px) rotateY(180deg);
    }
  }

  @media (max-width: 960px) {
    .sourcing-categories__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .sourcing-categories {
      padding: 4.5rem 0;
    }

    .sourcing-categories__intro {
      margin-bottom: 2rem;
    }

    .sourcing-categories__grid {
      grid-template-columns: 1fr;
    }

    .sourcing-card,
    .sourcing-card__inner {
      min-height: 540px;
    }

    .sourcing-card__face {
      padding: 1.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sourcing-card__inner {
      transition: none;
    }

    .sourcing-card:hover .sourcing-card__inner,
    .sourcing-card.is-flipped:hover .sourcing-card__inner {
      filter: none;
    }
  }
</style>
