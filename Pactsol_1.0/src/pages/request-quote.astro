---
import Layout from '../layouts/Layout.astro';

const tallyUrl = 'https://tally.so/embed/lb2Mko?dynamicHeight=1';
---

<Layout
  title="Request a Quote | PACTSOL"
  description="Submit an industrial sourcing requirement to PACTSOL for review and sourcing coordination."
>
  <section
    class="form-page"
    aria-labelledby="request-quote-heading"
  >
    <header class="form-page__header">
      <p class="form-page__eyebrow">
        Buyer Sourcing Enquiry
      </p>

      <h1 id="request-quote-heading">
        Request a Quote
      </h1>

      <p
        id="request-quote-description"
        class="form-page__intro"
      >
        Tell us what you are looking to procure. PACTSOL will review the
        requirement and, where appropriate, coordinate relevant sourcing
        options for your consideration.
      </p>

      <p class="form-page__field-summary">
        The enquiry form asks for your organisation and contact details,
        product or material requirement, quantity, delivery date, delivery
        location, and any additional information relevant to the requirement.
      </p>
    </header>

    <div class="form-page__privacy-notice">
      <p>
        By submitting this form, you provide PACTSOL with business contact and
        sourcing information so that we can review your requirement, communicate
        with you, and coordinate relevant sourcing activity where appropriate.
        Please avoid submitting unnecessary personal, confidential, or sensitive
        information.
      </p>

      <p>
        For details about how PACTSOL handles personal information and privacy
        requests, please review our <a href="/privacy">Privacy Policy</a>.
      </p>
    </div>

    <div class="form-page__embed">
      <iframe
        src={tallyUrl}
        data-tally-src={tallyUrl}
        width="100%"
        height="200"
        title="PACTSOL Request a Quote form"
        aria-describedby="request-quote-description request-quote-fallback"
      ></iframe>

      <script
        is:inline
        src="https://tally.so/widgets/embed.js"
      ></script>

      <p
        id="request-quote-fallback"
        class="form-page__fallback"
      >
        If the embedded form does not load, you can
        <a
          href={tallyUrl}
          target="_blank"
          rel="noopener noreferrer"
        >open the Request a Quote form directly</a>.
      </p>
    </div>
  </section>

  <style>
    .form-page__header {
      max-width: 820px;
      margin-bottom: 28px;
    }

    .form-page__eyebrow {
      margin: 0 0 10px;
      color: var(--color-accent);
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .form-page__header h1 {
      margin: 0;
      color: var(--color-primary);
      font-size: clamp(2.2rem, 5vw, 3.25rem);
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    .form-page__intro,
    .form-page__field-summary {
      max-width: 760px;
      color: var(--color-text);
      line-height: 1.75;
    }

    .form-page__intro {
      margin: 18px 0 0;
      font-size: 1.02rem;
    }

    .form-page__field-summary {
      margin: 14px 0 0;
      font-size: 0.95rem;
    }

    .form-page__embed {
      margin-top: 24px;
    }

    .form-page__fallback {
      margin: 16px 0 0;
      color: var(--color-text);
      font-size: 0.92rem;
      line-height: 1.6;
    }

    .form-page__fallback a {
      color: var(--color-primary);
      font-weight: 700;
    }

    @media (max-width: 600px) {
      .form-page__header {
        margin-bottom: 22px;
      }
    }
  </style>
</Layout>
