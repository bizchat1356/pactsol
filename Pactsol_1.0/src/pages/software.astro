---
import Layout from '../layouts/Layout.astro';
const enquiry = 'mailto:hello@pactsol.in?subject=Software%20consultancy%20enquiry&body=Company%3A%0AApplication%20summary%3A%0AAssessment%20needed%3A%0AApproximate%20test%20set%20size%3A%0ATarget%20date%3A%0A';
const services = [
 ['01','LLM response evaluation','Review correctness, instruction following and consistency against an agreed rubric.','Scored results, failure examples and a findings summary.'],
 ['02','RAG quality assessment','Assess supplied questions, retrieved context and answers for grounding, citation support and relevance.','Evidence-linked findings and retrieval or answer-quality observations.'],
 ['03','Prompt regression review','Compare two prompt or model versions against a fixed test set to understand improvements and regressions.','Version comparison, reproducible examples and prioritised recommendations.'],
 ['04','API & functional assessment','Review agreed application flows and API behaviour in an authorised test environment.','Test coverage summary and reproducible defects with severity rationale.']
];
---
<Layout title="Software Consultancy & AI Evaluation | PACTSOL" description="Scoped LLM, RAG, prompt regression and software quality assessments. Clear test coverage, reproducible evidence and actionable findings.">
<section class="business-hero software-hero"><div class="site-container"><p class="business-eyebrow">Software consultancy / AI & quality</p><h1>Know what works.<br /><span>See what needs attention.</span></h1><p class="business-intro">Focused quality assessments for teams building software and AI applications. Clear scope, reviewed evidence and a useful handover.</p><a class="business-button" href="#assessment">Discuss an assessment ↗</a><p class="business-small">Project-based engagements · Remote delivery · Scope agreed before work starts</p></div></section>
<section class="business-section"><div class="site-container"><p class="business-eyebrow">Assessment services</p><h2>A focused review of the questions that matter.</h2><div class="business-grid">{services.map(([n,title,description,output]) => <article class="business-card"><span class="business-number">{n}</span><h3>{title}</h3><p>{description}</p><p><strong>You receive:</strong> {output}</p></article>)}</div></div></section>
<section class="business-section business-soft"><div class="site-container"><p class="business-eyebrow">From scope to handover</p><div class="business-steps"><article><span>01</span><h3>Define</h3><p>Agree the application version, dataset, rubric, permitted tools and acceptance criteria.</p></article><article><span>02</span><h3>Assess</h3><p>Run the agreed checks, review the evidence and document reproducible observations.</p></article><article><span>03</span><h3>Deliver</h3><p>Receive scored findings, limitations and recommendations, with corrections as agreed in the scope.</p></article></div></div></section>
<section class="business-section"><div class="site-container business-split"><div><p class="business-eyebrow">Clear expectations</p><h2>Useful evidence.<br />Defined boundaries.</h2></div><div><p>Assessments cover the agreed sample and version. They do not certify that an application is error-free, safe for every use or compliant with every regulation.</p><p>Production deployment, ongoing monitoring, security penetration testing and specialist legal or medical validation are outside the standard assessment scope.</p><p>Client data is used with authorised access and agreed handling rules. Any external AI tools and their data use must be approved for the engagement.</p><p>Delivery personnel, confidentiality, fees and support arrangements are agreed before work begins.</p></div></div></section>
<section id="assessment" class="business-section business-soft"><div class="site-container business-split"><div><p class="business-eyebrow">Start a conversation</p><h2>What would you<br />like to evaluate?</h2></div><div><p>Send your company name, a brief application summary, the assessment you need, approximate test-set size and target date.</p><p>Please do not send credentials, personal datasets or confidential source code in an initial enquiry.</p><a class="business-button" href={enquiry}>Email an assessment enquiry ↗</a><p class="business-small">Opens your email application. You can also write directly to <a href="mailto:hello@pactsol.in">hello@pactsol.in</a>.</p></div></div></section>
</Layout>
