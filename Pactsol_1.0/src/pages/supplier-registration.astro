---
import Layout from '../layouts/Layout.astro';

const tallyUrl = 'https://tally.so/embed/PdQrdB?dynamicHeight=1';
---

<Layout title="Supplier Registration | PACTSOL">
  <section class="form-page supplier-form-page">
    <div class="form-page__privacy-notice">
      <p>
        By submitting this form, you provide PACTSOL with business contact and
        supplier capability information so that we can review your registration,
        communicate with you, and consider your business for relevant sourcing
        opportunities where appropriate. Please avoid submitting unnecessary
        personal, confidential, or sensitive information.
      </p>

      <p>
        For details about how PACTSOL handles personal information and privacy
        requests, please review our <a href="/privacy">Privacy Policy</a>.
      </p>
    </div>

    <iframe
      data-tally-src={tallyUrl}
      loading="lazy"
      width="100%"
      height="200"
      title="Supplier Registration Form"
    ></iframe>

    <script
      is:inline
      src="https://tally.so/widgets/embed.js"
    ></script>
  </section>
</Layout>
