---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'PACTSOL | Sourcing & Software Consultancy',
  description =
    'PACTSOL provides managed industrial sourcing and scoped software quality assessments.',
} = Astro.props;

const isSoftware = Astro.url.pathname.startsWith('/software');
const canonicalBase = (isSoftware ? import.meta.env.PUBLIC_SOFTWARE_ORIGIN : import.meta.env.PUBLIC_PORTAL_ORIGIN) || Astro.site;
const canonicalURL = new URL(Astro.url.pathname === "/404/" ? "/404.html" : Astro.url.pathname, canonicalBase);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content={description}
    />

    <link
      rel="canonical"
      href={canonicalURL}
    />

    <meta
      name="robots"
      content="index, follow"
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalURL}
    />

    <meta
      property="og:site_name"
      content="PACTSOL"
    />

    <meta
      name="twitter:card"
      content="summary"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="generator"
      content={Astro.generator}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="icon"
      href="/favicon.ico"
    />

    <title>{title}</title>
  </head>

  <body>
    <Header />

    <a class="skip-link" href="#main-content">Skip to content</a>
    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <ScrollToTop />

    <script
      is:inline
      src="/scripts/scroll-to-top.js"
    ></script>


  </body>
</html>